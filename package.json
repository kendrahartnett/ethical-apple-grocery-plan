{
  "name": "ethical-apple",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "node scripts/dev.js",
    "server": "node --env-file-if-exists=.env server/index.js",
    "pricing:catalog": "node --env-file-if-exists=.env scripts/pricing-catalog.js",
    "test": "node --test tests/*.test.js",
    "build": "vite build --config vite.config.js --configLoader native",
    "preview": "vite preview --config vite.config.js --configLoader native --host 127.0.0.1"
  },
  "devDependencies": {
    "vite": "^7.3.6"
  }
}
